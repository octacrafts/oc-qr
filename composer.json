{
    "name": "octacrafts/oc-qr",
    "version": "1.0.0",
    "description": "Framework-agnostic QR Code generation library for PHP (ISO/IEC 18004)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "qr",
        "qr-code",
        "qrcode",
        "barcode",
        "iso-18004",
        "png",
        "svg"
    ],
    "authors": [
        {
            "name": "Octacrafts",
            "homepage": "https://github.com/octacrafts"
        }
    ],
    "support": {
        "issues": "https://github.com/octacrafts/oc-qr/issues",
        "source": "https://github.com/octacrafts/oc-qr"
    },
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Octacrafts\\QrEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Octacrafts\\QrEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
